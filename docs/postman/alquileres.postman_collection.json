{
  "info": {
    "name": "Alquiler Equipos Médicos - Colección",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"email\": \"ana@clinica.com\",\n  \"password\": \"123456\",\n  \"rol\": \"CLIENTE\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ana@clinica.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Me (token required)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "me"]
        }
      }
    },
    {
      "name": "Listar equipos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/equipos",
          "host": ["{{base_url}}"],
          "path": ["api", "equipos"]
        }
      }
    },
    {
      "name": "Crear equipo (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ventilador X\",\n  \"descripcion\": \"Ventilador portátil\",\n  \"precioDia\": 50000,\n  \"stock\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/equipos",
          "host": ["{{base_url}}"],
          "path": ["api", "equipos"]
        }
      }
    },
    {
      "name": "Crear alquiler",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": 1,\n  \"fechaInicio\": \"2026-10-20\",\n  \"fechaFin\": \"2026-10-22\",\n  \"items\": [\n    {\n      \"equipoId\": 1,\n      \"cantidad\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/alquileres",
          "host": ["{{base_url}}"],
          "path": ["api", "alquileres"]
        }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ]
}
